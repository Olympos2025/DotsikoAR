<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard" version="3.0" toolsVersion="12568" targetRuntime="iOS.CocoaTouch" useSafeAreas="YES">
    <scenes>
        <!--View Controller-->
        <scene sceneID="view-scene">
            <objects>
                <viewController id="ViewController" customClass="ViewController" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="main-view">
                        <subviews>
                            <scnView contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="sceneView">
                                <connections>
                                    <outlet property="sceneView" destination="ViewController" id="scene-outlet"/>
                                </connections>
                            </scnView>
                        </subviews>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="sceneView" firstAttribute="top" secondItem="main-view" secondAttribute="top" id="top-constraint"/>
                            <constraint firstItem="sceneView" firstAttribute="bottom" secondItem="main-view" secondAttribute="bottom" id="bottom-constraint"/>
                            <constraint firstItem="sceneView" firstAttribute="leading" secondItem="main-view" secondAttribute="leading" id="leading-constraint"/>
                            <constraint firstItem="sceneView" firstAttribute="trailing" secondItem="main-view" secondAttribute="trailing" id="trailing-constraint"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
</document>
